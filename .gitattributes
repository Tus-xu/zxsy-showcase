# 只对文本源固定 LF：保证离线单文件构建与 checkout 路径/平台设置无关。
# 注意：不要写成 app/**（会把 app/public 下的 PNG 当文本做换行转换，破坏图片）。
app/index.html text eol=lf
app/vite.config.offline.mjs text eol=lf
app/src/** text eol=lf
# 例外：src 下的位图/字体是二进制，必须逐字节保留（上面那条会把它们当文本做换行转换）
app/src/**/*.png -text
app/src/**/*.jpg -text
app/src/**/*.jpeg -text
app/src/**/*.webp -text
app/src/**/*.gif -text
app/src/**/*.ico -text
app/src/**/*.woff -text
app/src/**/*.woff2 -text
app/src/**/*.mp3 -text
app/src/**/*.ttf -text
app/src/**/*.pdf -text
.gitattributes text eol=lf
# 生成的单文件发行包必须逐字节保留（CRLF 转换会让验收 SHA 失效）
release/*.html -text

# V3 原型的单文件产物必须逐字节保留（换行转换会让验收 SHA 失效）
v3-prototype/*.html -text
